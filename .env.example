# ── Existing ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://...
REDIS_URL=redis://localhost:6379
JWT_SECRET=...
JWT_REFRESH_SECRET=change-me-refresh-secret
REDIS_ENABLED=true
CACHE_TTL_SECONDS=60

# ── Platform / Production ─────────────────────────────
DEBUG=true
CORS_ORIGINS=["*"]
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage
MAX_FILE_SIZE_BYTES=1048576

# MinIO (STORAGE_BACKEND=minio)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false

# Cloudflare R2 (STORAGE_BACKEND=r2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Grafana Cloud (Prometheus remote_write — optional; prometheus service reads these)
GRAFANA_CLOUD_REMOTE_WRITE_URL=
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_TOKEN=
GRAFANA_ADMIN_PASSWORD=              # local Grafana only if added to compose

# ── AI Providers ──────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...                    # embeddings (gemini/gemini-embedding-2)
NVIDIA_NIM_API_KEY=nvapi-...          # LLM via NVIDIA NIM (40 RPM typical)
NVIDIA_API_KEY=                       # alias for NVIDIA_NIM_API_KEY
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_FALLBACKS=gemini/gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=4
LLM_RETRY_MIN_WAIT=2.0
LLM_RETRY_MAX_WAIT=60.0
LLM_STRUCTURED_MAX_TOKENS_TAGS=256
LLM_STRUCTURED_MAX_TOKENS_METADATA=512

# ── Embeddings ────────────────────────────────────────
EMBEDDING_PROVIDER=openai          # legacy label — EMBEDDING_MODEL selects provider
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# ── Chunking ──────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_MIN_LENGTH=50

# ── Qdrant (local dev: http://127.0.0.1:6333 ; Compos sets http://qdrant:6333) ──
QDRANT_URL=https://cloud.qdrant.io
QDRANT_API_KEY=qdrant-api-key
QDRANT_NOTES_COLLECTION=notes_chunks
QDRANT_FILES_COLLECTION=files_chunks
QDRANT_TIMEOUT=30

# ── Neo4j (Phase 9 — leave blank until then) ──────────
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── LangSmith ─────────────────────────────────────────
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=dashnote
LANGSMITH_TRACING_ENABLED=false    # true from Phase 5 onwards

# ── Langfuse (LLM/RAG tracing — Step 3 wires RagService) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── ARQ Worker ────────────────────────────────────────
ARQ_REDIS_URL=redis://localhost:6379
WORKER_MAX_JOBS=5                  # align with OpenAI tier TPM
WORKER_JOB_TIMEOUT=300             # ARQ job timeout (worker; not in Settings)

# ── Cost Controls ─────────────────────────────────────
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=86400          # 24h — chunk vectors rarely change
TOKEN_BUDGET_PER_REQUEST=8000

# ── AI Memory & Agent ─────────────────────────────────
AI_THREAD_MESSAGE_LIMIT=20
AGENT_MAX_ITERATIONS=10
AGENT_TOOL_TIMEOUT=30

# ── Inbound channels (email / WhatsApp) ───────────────
# Leave INBOUND_API_KEY empty to disable inbound email until configured.
INBOUND_API_KEY=
INBOUND_HMAC_SECRET=                 # optional hex HMAC of raw body (sha256)
INBOUND_AGENTIC_ENABLED=false
INBOUND_AGENTIC_TIMEOUT_SECONDS=12
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# ── Grafana Cloud (legacy names — prefer GRAFANA_CLOUD_* above) ──
GRAFANA_CLOUD_STACK_URL=https://YOUR-STACK.grafana.net
GRAFANA_CLOUD_API_TOKEN=
