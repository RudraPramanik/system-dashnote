# First-boot (no domain): copy this file to gitignored `.env.production`, fill secrets,
# then copy to the VPS as compose env_file `.env`:
#   cp .env.production.example .env.production
#   # edit .env.production locally — never commit it
#   scp .env.production user@<vps-ipv4>:/path/to/dashnotesystemv1/.env
# Never commit `.env` or `.env.production`. `.env.*` is gitignored except this example.

DEBUG=false
# Browser origins that call the API (sibling dashnotes FE). MUST NOT be "*".
# Production apex FE (not on this VPS): https://aisystem.world
# Local FE against prod or local API: keep localhost entries as needed.
CORS_ORIGINS=["https://aisystem.world","http://localhost:3000","http://127.0.0.1:3000"]

# Prefer hosted Postgres (Supabase/Neon). For asyncpg use ?ssl=require (not sslmode).
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DB?ssl=require
# Temporary on-VPS Postgres recovery (compose profile onbox-db):
#   ONBOX_DB=1
#   COMPOSE_PROFILES=onbox-db
#   POSTGRES_USER=dashuser
#   POSTGRES_PASSWORD=<same as DATABASE_URL password>
#   POSTGRES_DB=dashnotes
#   DATABASE_URL=postgresql+asyncpg://dashuser:<PASSWORD>@dashnote-postgres:5432/dashnotes
# ONBOX_DB=0

# Redis Cloud (recommended prod): same DSN for cache/rate-limit and ARQ when one free DB.
# BLPOP must work for ARQ. Example shape (password only in VPS .env — never commit):
#   redis://default:<PASSWORD>@<host>.db.redis.io:<port>
# Use rediss:// only if the provider requires TLS on that endpoint. Verify with PING.
# Do not add LAYERBASE_* / REDIS_PUBLIC_ENDPOINT as runtime settings — only REDIS_URL / ARQ_REDIS_URL.
REDIS_URL=redis://default:PASSWORD@HOST.db.redis.io:PORT
ARQ_REDIS_URL=redis://default:PASSWORD@HOST.db.redis.io:PORT

QDRANT_URL=https://xxxx.cloud.qdrant.io
QDRANT_API_KEY=

# Object storage — required on VPS (api/worker share no local volume).
# See docs/deployment/storage.md. Keep STORAGE_BACKEND=local only for docker-compose.yml.
STORAGE_BACKEND=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dashnote-prod

JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32

# LLM keys — at least one required for AI features
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
LLM_MODEL=nvidia_nim/nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_FALLBACKS=gemini/gemini-2.5-flash

# Optional password-reset mail (Resend). Empty = API still boots; forgot returns 200, no email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_PUBLIC_URL=https://app.your-domain.com

# Optional AI observability — deploy succeeds without these (soft).
# After setting keys or model lines above, recreate api+worker (runbook §6.1).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Blank → production when DEBUG=false. Set to label a shared Langfuse project.
# LANGFUSE_TRACING_ENVIRONMENT=
GRAFANA_CLOUD_REMOTE_WRITE_URL=
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_TOKEN=
