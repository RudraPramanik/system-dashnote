# First-boot (no domain): copy this file to gitignored `.env.production`, fill secrets,
# then copy to the VPS as compose env_file `.env`:
#   cp .env.production.example .env.production
#   # edit .env.production locally — never commit it
#   scp .env.production user@<vps-ipv4>:/path/to/dashnotesystemv1/.env
# Never commit `.env` or `.env.production`. `.env.*` is gitignored except this example.

DEBUG=false
# Browser origins that call the API (sibling dashnotes FE). MUST NOT be "*".
# First-boot without a domain: local FE origins are enough.
# After TLS: add https://app.your-domain.com.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Use the Postgres URL that actually reaches the VPS (session pooler :6543 vs direct).
# For asyncpg runtime use ?ssl=require (not sslmode). Alembic converts ssl=require → sslmode for psycopg2.
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DB?ssl=require
# Cache / rate limit. ARQ MAY use the same host if it supports blocking BLPOP.
REDIS_URL=rediss://:TOKEN@HOST:6379/0
ARQ_REDIS_URL=rediss://:TOKEN@HOST:6379/0

QDRANT_URL=https://xxxx.cloud.qdrant.io
QDRANT_API_KEY=

# Object storage — required on VPS (api/worker share no local volume).
# See docs/deployment/storage.md. Keep STORAGE_BACKEND=local only for docker-compose.yml.
STORAGE_BACKEND=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dashnote-prod

JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32

# LLM keys — at least one required for AI features
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# Optional observability — deploy succeeds without these
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GRAFANA_CLOUD_REMOTE_WRITE_URL=
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_TOKEN=
