# Copy to backend.hcl (gitignored) AFTER you create a dedicated tfstate bucket
# and DynamoDB lock table in eu-north-1.
#
# Do NOT use AWS Config buckets (e.g. config-bucket-… / AWSLogs/…).
# This S3 bucket is ONLY for Terraform's state file — not your app database.
# Hosted Postgres / Redis / Qdrant / R2 stay as they are.

bucket         = "dashnote-tfstate-010798385836"
region         = "eu-north-1"
dynamodb_table = "dashnote-tfstate-lock"
